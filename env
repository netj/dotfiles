#!/usr/bin/env bash
# run given command in the same environment setup as an interactive/login shell (BASH)
# Author: Jaeho Shin <netj@sparcs.org>
# Created: 2026-04-14
#
# Usage:
#   ssh host -t -- .dotfiles/env some-command arg args
#   ssh host -t -- .dotfiles/env NAME=VALUE ... some-command arg args
#   ssh host -t -- .dotfiles/env TERM=xterm-256color optmux some/project/dir/
##
envs=""
while [[ "${1:-}" == *=* ]]; do
    envs+="export $(printf %q "$1"); "
    shift
done
source /etc/profile
exec bash -ic "${envs}"'"$@"' -- "$@"
