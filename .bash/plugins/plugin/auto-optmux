#!/usr/bin/env bash
# Automatically pick an optmux project at login (ssh/mosh), and again after each detach or exit
#
# On login, this plugin offers to run `optmux pick` (an fzf list of projects to
# attach to) with a short timeout, like auto-tmux does.  When the picked
# project's session is detached or exited, it asks what to do next: re-pick
# (the default), drop into a normal shell, or exit.  Cancelling the picker
# (e.g., Esc) defaults to exit instead, so that the ssh/mosh connection ends
# unless you hit p to pick again or s for a shell.  If `optmux pick` fails (e.g.,
# no project to pick yet), a shell is the default so you can sort things out.
#
# If you don't want to automatically get the prompt on every login, but
# explicitly do so with the `aoptmux' command, then add the following line to
# your ~/.bash_local file:
#
#     auto_optmux_attach_at_login=false
#
# Requires optmux with `optmux pick` (https://github.com/netj/optmux).
# Environment is kept fresh in existing panes by tmux-env-sync.
#
# Author: Jaeho Shin <netj@sparcs.org>
# Created: 2026-10-24
# Requires: bpm.utils bpm.events bpm.interactive
# Conflicts: auto-tmux screen
################################################################################

# NOTE: bpm pastes this body into one compiled script that is sourced as a whole, so never `return` (or `exit`) here to bail out early: it would skip all plugins loaded after this one.
bash_plugin_login() {
    # we can't do much without optmux, a terminal, or when already inside tmux;
    # a local shell, unless auto-optmux was explicitly asked for, is left alone
    if type optmux &>/dev/null &&
        [[ -t 0 && -t 1 && -z "${TMUX:-}" ]] &&
        [[ -n "${SSH_CONNECTION:-}" || -n "${auto_optmux_attach_at_login:-}" ]]
    then
    # a shorthand for entering auto-optmux
    aoptmux() { auto_optmux_attach_at_login=true bash -l; }

    -auto-optmux-loop() {
        # leave the prompt for the shell unless asked otherwise
        local default_key=p; ${auto_optmux_attach_at_login:-true} || default_key=s
        local key= rc=0
        bash_getkey key "auto-optmux: [p]ick | [s*]hell | e[x]it? " 1 $default_key || key=s
        while true; do
            case $key in
                [pPrR]) # r is an unadvertised alias, from when it meant re-pick
                    rc=0
                    optmux pick || rc=$?  # returns after the project is detached/exited
                    # after a normal return (detach/exit) re-pick by default, quit when the picker was cancelled, and fall back to a shell when it failed (e.g., nothing to pick yet)
                    case $rc in
                        0) bash_getkey key "auto-optmux: [p]ick | [s*]hell | e[x]it? " 1 p || key=s ;;
                        130) bash_getkey key "auto-optmux: pick cancelled, [p]ick | [s*]hell | e[x]it? " 1 x || key=s ;;
                        *) bash_getkey key "auto-optmux: 'optmux pick' failed ($rc), [p]ick | [s*]hell | e[x]it? " 1 s || key=s ;;
                    esac
                    ;;
                [xX])
                    exit
                    ;;
                *) # any other key (or ^C) is the escape hatch to the normal shell
                    bash_remove_prompt -auto-optmux-loop
                    unset -f -- -auto-optmux-loop
                    return
                    ;;
            esac
        done
    }
    # older optmux releases don't know how to pick
    if optmux help 2>&1 | grep -q 'pick'; then
        # get into the loop after loading everything (hence, showing prompt)
        bash_add_prompt -auto-optmux-loop
    else
        echo "auto-optmux: this optmux has no 'pick' (upgrade optmux)" >&2
        unset -f -- -auto-optmux-loop
    fi
    fi
}
