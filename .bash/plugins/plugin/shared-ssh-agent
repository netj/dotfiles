#!/usr/bin/env bash
# Provide a working ssh-agent at login if one isn't already available.
#
# - If $SSH_AUTH_SOCK already points at a responsive agent (e.g. macOS's
#   launchd-managed agent, or a forwarded one from `ssh -A`), leave it alone.
# - Otherwise, start (or reuse) a per-host agent on a stable socket path
#   ~/.ssh/auth.sock so every shell and tmux pane on the host can share it.
#
# Author: Jaeho Shin <netj@sparcs.org>
# Created: 2026-05-03
# Requires: bpm.utils
################################################################################

bash_plugin_login() {
    # ssh-add exit codes: 0 = ok, 1 = no identities, 2 = can't connect
    -shared-ssh-agent-alive() {
        SSH_AUTH_SOCK=$1 ssh-add -l &>/dev/null
        local rc=$?
        [ $rc -eq 0 ] || [ $rc -eq 1 ]
    }
    -shared-ssh-agent-init() {
        # if the inherited SSH_AUTH_SOCK already works, don't override it
        ! [ -n "${SSH_AUTH_SOCK:-}" ] || ! -shared-ssh-agent-alive "$SSH_AUTH_SOCK" || return 0
        type ssh-agent &>/dev/null || return 0
        local sock=$HOME/.ssh/auth.sock
        local lockdir=$sock.lock
        local i
        # serialize concurrent logins so two shells don't race to start two agents
        for i in 1 2 3 4 5; do
            if mkdir "$lockdir" 2>/dev/null; then
                -shared-ssh-agent-alive "$sock" || {
                    rm -f "$sock"
                    ssh-agent -a "$sock" >/dev/null 2>&1
                }
                rmdir "$lockdir" 2>/dev/null
                break
            fi
            sleep 0.2
        done
        if -shared-ssh-agent-alive "$sock"; then
            export SSH_AUTH_SOCK=$sock
            unset SSH_AGENT_PID
        fi
    }
    -shared-ssh-agent-init
    unset -f -- -shared-ssh-agent-init -shared-ssh-agent-alive
}

